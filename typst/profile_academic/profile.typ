#import "../lib.typ": *

// Profile / summary. A short narrative opener — captures the
// diversity-of-experience and research-interest threads that the
// structured sections below convey only implicitly. Kept to ~3 lines;
// prose, no bullets.

#section("Profile")

#block(above: 4pt)[
  #set par(justify: true)
  #text(size: 9.5pt)[
    Neuroscientist whose path spans three countries (Mexico, Canada, and the
    USA) and three languages, moving from community psychology through
    clinical neuroimaging into computational neuroscience. My work develops
    and validates structural-MRI biomarkers of neurodegeneration and applies
    structural equation modeling to cognitive decline, paired with a sustained
    commitment to open, reproducible tools and to ethically grounded,
    participant-facing research with underrepresented populations.
  ]
]
