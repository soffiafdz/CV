#import "../lib.typ": *

// Profile / summary. A short narrative opener — captures the
// diversity-of-experience and research-interest threads that the
// structured sections below convey only implicitly. Kept to ~3 lines;
// prose, no bullets.

#section("Profile")

#block(above: 4pt)[
  #set par(justify: true)
  #text(size: 9.5pt)[
    I develop and validate structural-MRI biomarkers of neurodegeneration and
    apply structural equation modeling to cognitive decline. My path to this
    work spans three countries (Mexico, Canada, and the USA) and three
    languages — from community psychology through clinical neuroimaging into
    computational neuroscience — alongside a sustained commitment to open,
    reproducible tools and to ethically grounded, participant-facing research
    with underrepresented populations.
  ]
]
